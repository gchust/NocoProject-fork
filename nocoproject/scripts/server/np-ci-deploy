#!/usr/bin/env bash
# Forced command for the CI deploy key (command="…/np-ci-deploy" in ~/.ssh/authorized_keys).
# This key can only do one thing: `deploy <commit sha>`, receiving the build output over stdin and deploying it.
set -euo pipefail

read -r ACTION TAG EXTRA <<<"${SSH_ORIGINAL_COMMAND:-}"
if [ "$ACTION" != deploy ] || [ -n "${EXTRA:-}" ] || ! [[ "$TAG" =~ ^[0-9a-f]{7,40}$ ]]; then
  echo "only 'deploy <commit sha>' is allowed" >&2
  exit 2
fi
exec "$HOME/nocoproject/bin/np-deploy" "$TAG" --stdin
