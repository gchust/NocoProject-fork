#!/usr/bin/env bash
# Server-side deploy (installed on ali-agents at ~/nocoproject/bin/, synced there by scripts/deploy-server.sh). See docs/deploy.md.
#
#   np-deploy <tag>           deploy using the dist already uploaded to ~/nocoproject/build/
#   np-deploy <tag> --stdin   first unpack the tar.gz from stdin (dist/, Dockerfile, Dockerfile.dockerignore, config.example.yml)
#
# Order: back up the database -> build the image -> replace the container -> wait for the health check; if unhealthy, roll back to the previous image and exit non-zero.
# Daemon compatibility (NP-150): before replacing, compare what the new build requires of daemons (MIN_CLI_VERSION,
# SUPPORTED_PROTOCOLS.min) with the running image and warn when it rose; after a healthy start, wait for the daemons'
# next heartbeats and warn when the number of online runtimes dropped by half or more. Warnings never fail the deploy.
# NP_DEPLOY_RUNTIME_WAIT (seconds, default 45; 0 skips the after-check).
set -euo pipefail

TAG="${1:?usage: np-deploy <tag> [--stdin]}"
ROOT="$HOME/nocoproject"
BIND="${NP_DEPLOY_BIND:-100.89.167.29:13001}"
APP=nocoproject-app
exec 9>"$ROOT/.deploy.lock"
flock -w 600 9 || { echo "another deploy is running" >&2; exit 1; }

if [ "${2:-}" = --stdin ]; then
  rm -rf "$ROOT/build/dist"
  tar -xzf - -C "$ROOT/build"
fi
test -f "$ROOT/build/dist/package.json" || { echo "no dist in $ROOT/build" >&2; exit 1; }
# The "add a computer" install command downloads the CLI from the app; the build hook (scripts/pack-cli.sh) should have packed it into dist already. Don't deploy if it's missing.
ls "$ROOT"/build/dist/client/assets/cli/nocoproject-cli-*.tgz >/dev/null 2>&1 ||
  { echo "dist has no CLI installer (dist/client/assets/cli/); rebuild with pnpm build" >&2; exit 1; }

echo "==> backup database"
mkdir -p "$ROOT/backups"
BACKUP="$ROOT/backups/pre-deploy-$(date -u +%Y%m%dT%H%M%SZ)-$TAG.dump"
docker exec nocoproject-postgres pg_dump -U nocoproject -Fc nocoproject > "$BACKUP"
echo "    $BACKUP ($(du -h "$BACKUP" | cut -f1))"
# Keep the 10 most recent pre-deploy backups; daily backups are managed by np-backup.
ls -1t "$ROOT"/backups/pre-deploy-*.dump | tail -n +11 | xargs -r rm -f

# Reuse the image directly when there's no newly uploaded build and this tag's image still exists: `np-deploy <old tag>` is how you roll back.
if [ "${2:-}" != --stdin ] && [ "${NP_DEPLOY_REBUILD:-0}" != 1 ] && docker image inspect "nocoproject:$TAG" >/dev/null 2>&1; then
  echo "==> reuse existing image nocoproject:$TAG"
else
  echo "==> build image nocoproject:$TAG"
  docker build -q --build-arg DIST=prebuilt --build-arg APP_BASE_PATH=/main \
    -t "nocoproject:$TAG" -t nocoproject:latest "$ROOT/build" >/dev/null
fi

PREVIOUS="$(docker inspect -f '{{.Config.Image}}' "$APP" 2>/dev/null || true)"

COMPAT_JS=dist/server/modules/shared/protocol.daemon-compat.js
# `name value` pairs of what a build requires of daemons, from its compiled protocol file (empty before NP-150).
daemon_rules() {
  sed -nE "s/^export const MIN_CLI_VERSION = '([^']+)';/minCli \1/p; s/^export const SUPPORTED_PROTOCOLS = \{ min: ([0-9]+).*/minProtocol \1/p"
}
rule() { printf '%s\n' "$1" | awk -v k="$2" '$1 == k { print $2 }'; }
sql() { docker exec nocoproject-postgres psql -U nocoproject -d nocoproject -tAc "$1" 2>/dev/null || true; }
online_runtimes() { sql "select count(*) from runtimes where status = 'online' and last_seen_at > now() - interval '150 seconds'"; }

NEW_RULES="$(daemon_rules < "$ROOT/build/$COMPAT_JS" 2>/dev/null || true)"
OLD_RULES="$( [ -n "$PREVIOUS" ] && docker run --rm --entrypoint cat "$PREVIOUS" "/app/$COMPAT_JS" 2>/dev/null | daemon_rules || true)"
if [ -n "$NEW_RULES" ] && [ "$(rule "$NEW_RULES" minCli)" != "$(rule "$OLD_RULES" minCli)" -o "$(rule "$NEW_RULES" minProtocol)" != "$(rule "$OLD_RULES" minProtocol)" ]; then
  echo "!!! daemon requirements change: CLI $(rule "$OLD_RULES" minCli || true) -> $(rule "$NEW_RULES" minCli), protocol $(rule "$OLD_RULES" minProtocol || true) -> $(rule "$NEW_RULES" minProtocol)"
  echo "    Older daemons will show 'Upgrade required' (and get no work) until their owners run the upgrade command. Online runtimes by CLI version:"
  sql "select v || ': ' || n from (select coalesce((device_info #>> '{}')::json ->> 'daemonVersion', '?') as v, count(*) as n from runtimes where status = 'online' group by 1) t order by 1" | sed 's/^/      /'
fi
ONLINE_BEFORE="$(online_runtimes)"

run_app() {
  docker rm -f "$APP" >/dev/null 2>&1 || true
  # Rootless Docker takes a moment to release the port; retry when it's still in use.
  for _ in 1 2 3 4 5 6; do
    sleep 3
    # The container runs as root, which maps to the host's agents user, so it can read and write the mounted config.yml and storage; it only binds the Tailscale address, and Caddy reverse-proxies to it.
    if docker run -d --name "$APP" --user 0:0 --network nocoproject --restart unless-stopped \
      --env-file "$ROOT/app.env" -p "$BIND:13000" \
      -v "$ROOT/config.yml:/app/config.yml:ro" -v "$ROOT/storage:/app/storage" \
      "$1" >/dev/null 2>&1; then
      return 0
    fi
    docker rm -f "$APP" >/dev/null 2>&1 || true
  done
  echo "could not start container from $1" >&2
  return 1
}

healthy() {
  for _ in $(seq 1 60); do
    curl -sf -o /dev/null "http://$BIND/main/api/healthz" && return 0
    sleep 3
  done
  return 1
}

echo "==> replace container (previous: ${PREVIOUS:-none})"
if run_app "nocoproject:$TAG" && healthy; then
  echo "healthy: nocoproject:$TAG"
  WAIT="${NP_DEPLOY_RUNTIME_WAIT:-45}"
  if [ "$WAIT" -gt 0 ] && [ "${ONLINE_BEFORE:-0}" -gt 0 ] 2>/dev/null; then
    sleep "$WAIT"
    ONLINE_AFTER="$(online_runtimes)"
    echo "    online runtimes: ${ONLINE_BEFORE} before, ${ONLINE_AFTER:-?} now"
    if [ "${ONLINE_AFTER:-0}" -lt $(((ONLINE_BEFORE + 1) / 2)) ] 2>/dev/null; then
      echo "!!! online runtimes dropped from $ONLINE_BEFORE to ${ONLINE_AFTER:-0}; runtimes waiting for an upgrade: $(sql "select count(*) from runtimes where status = 'upgrade_required'")"
    fi
  fi
  # Keep the 3 most recent image versions to make rollback easy.
  docker images nocoproject --format '{{.Tag}}' | grep -v '^latest$' | tail -n +4 |
    xargs -r -I{} docker rmi "nocoproject:{}" >/dev/null 2>&1 || true
  exit 0
fi

echo "nocoproject:$TAG did not become healthy; last logs:" >&2
docker logs --tail 60 "$APP" >&2 || true
if [ -n "$PREVIOUS" ] && [ "$PREVIOUS" != "nocoproject:$TAG" ]; then
  echo "==> rolling back to $PREVIOUS (database migrations are not reverted; backup: $BACKUP)" >&2
  run_app "$PREVIOUS" && healthy && echo "rolled back: $PREVIOUS" >&2
fi
exit 1
